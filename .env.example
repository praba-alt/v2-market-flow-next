# Public client-side Solana RPC used by pages/index.js.
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Server-side RPC used by pages/api/pinksale-tokenomics.js for Solana lock decoding.
SOLANA_RPC_URL=https://node-solana.pinksale.com/

# Optional EVM RPC overrides used by pages/api/pinksale-tokenomics.js.
ETHEREUM_RPC_URL=https://ethereum.publicnode.com
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
POLYGON_RPC_URL=https://polygon-bor.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one.publicnode.com
BASE_RPC_URL=https://base.publicnode.com
ZETACHAIN_RPC_URL=https://zetachain-evm.blockpi.network/v1/rpc/public
ALVEY_RPC_URL=https://rpc.alvey.io

# Legacy local key seen in .env.local but not currently referenced by the app.
# NEXT_ALCHEMY_KEY=
