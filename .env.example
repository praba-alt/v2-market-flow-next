# Private server-side Alchemy key used by pages/api/non-evm-rpc.js.
ALCHEMY_KEY=
NEXT_ALCHEMY_KEY=

# Fortuna-app compatible RPC naming
ETHEREUM_RPC=
SOLANA_RPC=
BSC_RPC=
RPC_ETH=
RPC_POLYGON=
RPC_ARBITRUM=
RPC_BASE=

# SQLite path for contract-based pool ingestion.
CONTRACT_POOLS_DB_PATH=./data/contract-pools.sqlite
CONTRACT_POOLS_CRON_SECRET=
# Optional Vercel-compatible secret fallback:
# CRON_SECRET=

# Optional EVM RPC overrides for ABI enrichment.
# If not set, defaults in lib/pinksale-chains.js are used.
ETHEREUM_RPC_URL=
CRONOS_RPC_URL=
BSC_RPC_URL=
SHIBARIUM_RPC_URL=
UNICHAIN_RPC_URL=
POLYGON_RPC_URL=
XLAYER_RPC_URL=
FANTOM_RPC_URL=
PULSECHAIN_RPC_URL=
CORE_RPC_URL=
DOGECHAIN_RPC_URL=
ALVEY_RPC_URL=
ZETACHAIN_RPC_URL=
BITROCK_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
AVALANCHE_RPC_URL=

# Optional non-EVM RPC overrides
SUI_RPC=
SUI_RPC_URL=
TON_RPC=
TON_RPC_URL=

# Optional explorer keys for contract creation-time enrichment
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=
SNOWTRACE_API_KEY=
